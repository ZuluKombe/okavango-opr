  "workflow": {
    "workflow_name": "Okavango Operational Payment Approval",
    "document_type": "Operational Payment Request",
    "workflow_state_field": "workflow_state",
    "is_active_after_approval": 1,
    "states": [
      {
        "state": "Draft",
        "doc_status": "0",
        "allow_edit": "Operational Payment Requester"
      },
      {
        "state": "Pending Approval",
        "doc_status": "0",
        "allow_edit": "Operational Payment Approver"
      },
      {
        "state": "Approved",
        "doc_status": "1",
        "allow_edit": "Operational Payment Finance"
      },
      {
        "state": "Paid",
        "doc_status": "1",
        "allow_edit": "Operational Payment Finance"
      }
    ],
    "transitions": [
      {
        "state": "Draft",
        "action": "Send Operational Payment for Approval",
        "next_state": "Pending Approval",
        "allowed": "Operational Payment Requester",
        "allow_self_approval": 1,
        "condition": null
      },
      {
        "state": "Pending Approval",
        "action": "Approve Operational Payment",
        "next_state": "Approved",
        "allowed": "Operational Payment Approver",
        "allow_self_approval": 0,
        "condition": null
      },
      {
        "state": "Pending Approval",
        "action": "Return Operational Payment to Draft",
        "next_state": "Draft",
        "allowed": "Operational Payment Approver",
        "allow_self_approval": 0,
        "condition": null
      },
      {
        "state": "Approved",
        "action": "Mark Operational Payment Paid",
        "next_state": "Paid",
        "allowed": "Operational Payment Finance",
        "allow_self_approval": 0,
        "condition": null
      },
      {
        "state": "Paid",
        "action": "Reopen Operational Payment for Correction",
        "next_state": "Approved",
        "allowed": "Operational Payment Finance",
        "allow_self_approval": 0,
        "condition": null
      }
    ]
  },
